---
// The Simple Touch panel: Synthux's drawing (Roey Tsemah, adapted by Fabio
// Bartali), in the faceplate's colours, with each control's code and name
// over it. Positions on the drawing after Jon Waterschoot's
// simple-touch-labels (MIT). Pointed at, a control rings in light; a switch,
// its lever drawn at an angle, lights its name.
import { CONTROLS } from "../lib/controls";
import { url } from "../lib/url";

// Where each control sits on the drawing, in its units
const AT: Record<string, [number, number]> = {
  P10: [448.4, 169.7], P11: [647.1, 169.7],
  S36: [152.3, 739.7], S37: [928.7, 739.7],
  S31: [287.39, 611.53], S32: [457.21, 611.53], S33: [629.43, 611.53], S34: [800.08, 611.53],
  S30: [287.39, 800.66], S35: [800.08, 800.66],
  P00: [323.6, 1010.5], P01: [560.0, 995.7], P02: [706.5, 1013.4],
  P03: [180.1, 1277.9], P04: [359.9, 1226.2], P05: [525.2, 1270.5], P06: [710.9, 1258.7],
  P07: [916.8, 1328.2], P08: [384.6, 1447.9], P09: [700.7, 1452.3],
  S09: [433.2, 1044.0], S07: [590.7, 1117.0],
};
const JACKS: [string, number, number][] = [["IN", 152.8, 283.8], ["OUT", 152.8, 454.8]];
const KNOB_R = 34;
const PAD_R = 62;
const TOP_PAD_R = 52;
const FADER = { half: 140, w: 34 };
const SWITCH = { w: 70, h: 96 }; // the hit area round a lever, its name below
---
<svg class="touch" viewBox="70 75 940 1475" role="img" aria-label="The Simple Touch panel with each control's name">
  <title>Simple Touch panel drawing: Roey Tsemah, Synthux Academy</title>
  <image href={url("simple-touch-panel.svg")} x="70" y="75" width="940" height="1475" />
  {JACKS.map(([label, x, y]) => <text class="code side" x={x + 48} y={y + 9}>{label}</text>)}
  {CONTROLS.filter((c) => AT[c.id]).map((c) => {
    const [x, y] = AT[c.id];
    const cls = `ctl ${c.type}${c.free ? " free" : ""}`;
    const tab = c.free ? undefined : 0;
    if (c.type === "knob") {
      return (
        <g class={cls} data-id={c.id} tabindex={tab}>
          <circle class="hit" cx={x} cy={y} r={KNOB_R + 18} />
          <circle class="ring" cx={x} cy={y} r={KNOB_R + 10} />
          <text class="code" x={x} y={y - KNOB_R - 22}>{c.id}</text>
          <text class="name" x={x} y={y + KNOB_R + 44}>{c.name}</text>
        </g>
      );
    }
    if (c.type === "fader") {
      return (
        <g class={cls} data-id={c.id} tabindex={tab}>
          <rect class="hit" x={x - FADER.w} y={y - FADER.half - 20} width={2 * FADER.w} height={2 * FADER.half + 40} />
          <rect class="ring" x={x - FADER.w / 2 - 8} y={y - FADER.half - 8} width={FADER.w + 16} height={2 * FADER.half + 16} rx={FADER.w / 2 + 8} />
          <text class="code" x={x} y={y - FADER.half - 30}>{c.id}</text>
          <text class="name" x={x} y={y + FADER.half + 56}>{c.name}</text>
        </g>
      );
    }
    if (c.type === "switch") {
      return (
        <g class={cls} data-id={c.id} tabindex={tab}>
          <rect class="hit" x={x - SWITCH.w} y={y - SWITCH.h / 2 - 10} width={2 * SWITCH.w} height={SWITCH.h + 20} />
          <text class="code" x={x} y={y + SWITCH.h / 2 + 34}>{c.id}</text>
          <text class="name" x={x} y={y + SWITCH.h / 2 + 66}>{c.name}</text>
        </g>
      );
    }
    const r = c.id === "P10" || c.id === "P11" ? TOP_PAD_R : PAD_R;
    return (
      <g class={cls} data-id={c.id} tabindex={tab}>
        <circle class="hit" cx={x} cy={y} r={r} />
        <circle class="ring" cx={x} cy={y} r={r} />
        <text class="code" x={x} y={y - 6}>{c.id}</text>
        <text class="name" x={x} y={y + 26}>{c.name}</text>
      </g>
    );
  })}
</svg>
