---
// The Simple Touch panel as a drawing: every control where it sits on the
// board, at its starting value, with its name. Built once, no script.
import { CONTROLS, POSITION } from "../lib/controls";

const KNOB_R = 40;
const SWEEP = 270;
const FADER = { top: 300, bottom: 545 };
const PAD_R = 40;

function polar(cx: number, cy: number, r: number, deg: number): [number, number] {
  const a = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
}
function arc(cx: number, cy: number, r: number, from: number, to: number) {
  const [x0, y0] = polar(cx, cy, r, from);
  const [x1, y1] = polar(cx, cy, r, to);
  return `M${x0} ${y0}A${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${x1} ${y1}`;
}
const knobDeg = (v: number) => -SWEEP / 2 + v * SWEEP;
const faderY = (v: number) => FADER.bottom - v * (FADER.bottom - FADER.top);
const leverY = (p: number) => (p === POSITION.up ? -26 : p === POSITION.down ? 8 : -9);
---
<svg class="touch" viewBox="0 0 600 973" role="img" aria-label="The Simple Touch panel with each control's name">
  <rect class="plate" x="2" y="2" width="596" height="969" rx="18" />
  {[[50, 26], [550, 26], [50, 947], [550, 947]].map(([x, y]) => <rect class="hole" x={x - 18} y={y - 9} width="36" height="18" rx="9" />)}
  {[[118, "IN"], [196, "OUT"]].map(([y, label]) => (
    <g><circle class="jack" cx="34" cy={y} r="13" /><text class="code" x="34" y={Number(y) + 34}>{label}</text></g>
  ))}
  {CONTROLS.filter((c) => !c.second).map((c) => {
    const v = c.initial ?? 0;
    const cls = `ctl ${c.type}${c.free ? " free" : ""}`;
    if (c.type === "knob") {
      const [dx, dy] = polar(c.x, c.y, KNOB_R - 18, knobDeg(v));
      return (
        <g class={cls} data-id={c.id}>
          <path class="track" d={arc(c.x, c.y, KNOB_R, -SWEEP / 2, SWEEP / 2)} />
          {v > 0.002 && <path class="arc" d={arc(c.x, c.y, KNOB_R, -SWEEP / 2, knobDeg(v))} />}
          <circle class="ring" cx={c.x} cy={c.y} r={KNOB_R - 9} />
          <circle class="lever" cx={dx} cy={dy} r="4" />
          <text class="code" x={c.x} y={c.y + 5}>{c.id}</text>
          <text class="name" x={c.x} y={c.y + KNOB_R + 24}>{c.name}</text>
        </g>
      );
    }
    if (c.type === "fader") {
      const y = faderY(v);
      return (
        <g class={cls} data-id={c.id}>
          <line class="track" x1={c.x} x2={c.x} y1={FADER.top} y2={FADER.bottom} />
          <line class="travel" x1={c.x} x2={c.x} y1={y} y2={FADER.bottom} />
          <rect class="cap" x={c.x - 22} y={y - 10} width="44" height="20" rx="5" />
          <text class="code" x={c.x} y={FADER.top - 22}>{c.id}</text>
          <text class="name" x={c.x} y={FADER.bottom + 38}>{c.name}</text>
        </g>
      );
    }
    if (c.type === "switch") {
      // S09's name below it, clear of P01
      const [lx, ly] = c.id === "S09" ? [0, 52] : [46, -2];
      return (
        <g class={cls} data-id={c.id}>
          <rect class="slot" x={c.x - 14} y={c.y - 30} width="28" height="60" rx="8" />
          <rect class="lever" x={c.x - 9} y={c.y + leverY(v)} width="18" height="18" rx="4" />
          <text class="code" x={c.x + lx} y={c.y + ly}>{c.id}</text>
          <text class="name" x={c.x + lx} y={c.y + ly + 20}>{c.name}</text>
        </g>
      );
    }
    return (
      <g class={cls} data-id={c.id}>
        <circle class="pad" cx={c.x} cy={c.y} r={PAD_R} />
        <text class="code" x={c.x} y={c.y - 7}>{c.id}</text>
        <text class="name" x={c.x} y={c.y + 15}>{c.name}</text>
      </g>
    );
  })}
</svg>
