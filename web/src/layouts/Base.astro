---
import "@fontsource/barlow-semi-condensed/500.css";
import "@fontsource/barlow-semi-condensed/600.css";
import "@fontsource/barlow-semi-condensed/700.css";
import "../styles/site.css";
import { url } from "../lib/url";
import { COLOUR, css, matrix } from "../lib/tokens";

// Play is a part with its own structure: no footer, the page fills the
// screen, on phones no nav row. Reading pages are light, dark on a dark system.
interface Props {
  title?: string;
  description?: string;
  app?: boolean;
  reading?: boolean;
}

const { title, app = false, reading = false, description = "A real-time granular sampler inspired by the hourglass, for the Synthux Simple Touch 2." } = Astro.props;
const pageTitle = title ? `${title} · Clessidra` : "Clessidra";
const path = Astro.url.pathname;
const nav = [
  { path: "play/", title: "Play" },
  { path: "controls/", title: "Controls" },
  { path: "engine/", title: "Engine" },
  { path: "download/", title: "Download" },
  { path: "feedback/", title: "Feedback" },
];
const current = (p: string) => path.startsWith(url(p));
const logo = matrix([..."CLESSIDRA"], "currentColor", 'class="logo" aria-hidden="true"');
---
<!doctype html>
<html lang="en" class={reading ? "reading" : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{reading ? (
  <>
    <meta name="theme-color" content={COLOUR.light.bg} media="(prefers-color-scheme: light)">
    <meta name="theme-color" content={COLOUR.black.bg} media="(prefers-color-scheme: dark)">
  </>
) : <meta name="theme-color" content={COLOUR.black.bg}>}
<style is:inline set:html={css()}></style>
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<link rel="icon" href={url("favicon.png")} type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")}>
<meta property="og:type" content="website">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={new URL(path, Astro.site)}>
<meta property="og:image" content={new URL(url("og.png"), Astro.site)}>
<meta name="twitter:card" content="summary_large_image">
<!-- Cloudflare Web Analytics: no cookies; one count per page. -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6e2758b8af12449988c12df6253593af"}'></script>
<slot name="head" />
</head>
<body class={app ? "app" : undefined}>
<header>
  <a class="mark" href={url()} aria-label="Clessidra"><Fragment set:html={logo} /></a>
  {app && <span class="label crumb"><span class="slash" aria-hidden="true">/</span>{title}</span>}
  <slot name="end" />
</header>
<nav class="label" aria-label="Pages">
  {nav.map((s) => <a href={url(s.path)} aria-current={current(s.path) ? "page" : undefined}>{s.title}</a>)}
</nav>
<main>
  <slot />
</main>
{!app && (
  <footer class="label">
    <a href="https://francescodimaggio.nl/">Francesco Di Maggio</a>
    <span class="links">
      <a href="https://github.com/francesco-di-maggio/clessidra">GitHub</a>
      <a href="https://www.linkedin.com/in/francesco-di-maggio/">LinkedIn</a>
      <a href="mailto:f.di.maggio@tue.nl">Email</a>
    </span>
  </footer>
)}
</body>
</html>
