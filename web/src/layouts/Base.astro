---
import "@fontsource/barlow-semi-condensed/500.css";
import "@fontsource/barlow-semi-condensed/600.css";
import "@fontsource/barlow-semi-condensed/700.css";
import "../styles/site.css";
import { url } from "../lib/url";
import { COLOUR, css, matrix } from "../lib/tokens";

// Play is a part with its own structure: the logo and its name, no pages,
// the page fills the screen, its footer only on a laptop.
interface Props {
  title?: string;
  description?: string;
  app?: boolean;
}

const { title, app = false, description = "A real-time granular sampler inspired by the hourglass, for the Synthux Simple Touch 2." } = Astro.props;
const pageTitle = title ? `${title} · Clessidra` : "Clessidra";
const path = Astro.url.pathname;
const nav = [
  { path: "play/", title: "Play" },
  { path: "controls/", title: "Controls" },
  { path: "engine/", title: "Engine" },
  { path: "download/", title: "Download" },
  { path: "feedback/", title: "Feedback" },
];
const current = (p: string) => path.startsWith(url(p));
const logo = matrix([..."CLESSIDRA"], "currentColor", 'class="logo" aria-hidden="true"');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content={COLOUR.black.bg}>
<style is:inline set:html={css()}></style>
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<link rel="icon" href={url("favicon.png")} type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href={url("apple-touch-icon.png")}>
<meta property="og:type" content="website">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={new URL(path, Astro.site)}>
<meta property="og:image" content={new URL(url("og.png"), Astro.site)}>
<meta name="twitter:card" content="summary_large_image">
<!-- Cloudflare Web Analytics: no cookies; one count per page. -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6e2758b8af12449988c12df6253593af"}'></script>
<slot name="head" />
</head>
<body class={app ? "app" : undefined}>
<canvas class="dust" aria-hidden="true"></canvas>
<header>
  <a class="mark" href={url()} aria-label="Clessidra"><Fragment set:html={logo} /></a>
  {app && <span class="label crumb"><span class="slash" aria-hidden="true">/</span>{title}</span>}
  <slot name="end" />
</header>
{!app && (
  <nav class="label" aria-label="Pages">
    {nav.map((s) => <a href={url(s.path)} aria-current={current(s.path) ? "page" : undefined}>{s.title}</a>)}
  </nav>
)}
<main>
  <slot />
</main>
<footer class="label">
  <span>© <a href="https://francescodimaggio.nl/">Francesco Di Maggio</a></span>
  <span class="links">
    <a href="https://www.linkedin.com/in/francesco-di-maggio/" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
    <a href="https://github.com/francesco-di-maggio/clessidra" aria-label="Source on GitHub" title="Source on GitHub"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.690-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
    <a href="mailto:f.di.maggio@tue.nl" aria-label="Email" title="Email"><svg viewBox="2 4 20 16" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg></a>
  </span>
</footer>
<script>
  import { fall } from "../lib/grains";
  fall(document.querySelector<HTMLCanvasElement>(".dust")!);
</script>
</body>
</html>
