---
import Base from "../layouts/Base.astro";

// Playing sessions, newest first
const SESSIONS = [
  { title: "Session 2", date: "29 Oct 2026", about: "1 min · firmware v0.2.0", video: "QP1ccBcmeWY" },
  { title: "Session 1", date: "5 Oct 2026", about: "5 min · Max prototype played from the Touch", video: "4GYZK3rs2Go" },
];
---
<Base title="Sessions" description="Clessidra played: videos from the playing sessions of the Synthux Design Residency 2026.">
<h1>Sessions</h1>
<p class="lead">Clessidra played, newest first.</p>

{SESSIONS.map((s) => (
  <section class="session">
    <h2 class="label"><span>{s.title}</span><span>{s.date}</span></h2>
    <div class="panel video">
      <iframe src={`https://www.youtube-nocookie.com/embed/${s.video}`} title={`Clessidra, ${s.title}`} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
    </div>
    <p class="caption">{s.about}</p>
  </section>
))}
</Base>
