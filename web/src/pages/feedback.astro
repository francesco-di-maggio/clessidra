---
import Base from "../layouts/Base.astro";
---
<Base title="Feedback" description="Tell what you played, what you heard and what you would change.">
<h1>Feedback</h1>
<p class="lead">Clessidra is in progress. Notes from playing it decide what changes next.</p>

<form id="feedback" class="panel form">
  <fieldset class="field">
    <legend class="label">Played on</legend>
    <div class="segmented" role="radiogroup">
      <label><input type="radio" name="where" value="Browser" checked><span>Browser</span></label>
      <label><input type="radio" name="where" value="Simple Touch"><span>Simple Touch</span></label>
    </div>
  </fieldset>
  <label class="field"><span class="label">Notes</span><textarea name="feedback" rows="7" required placeholder="What you played, what you heard, what you would change."></textarea></label>
  <div class="actions">
    <button class="control primary" type="submit">Send on GitHub</button>
    <button id="email" class="control" type="button">Send by Email</button>
  </div>
  <p class="caption">Opens a GitHub issue or an email with your notes. Nothing is sent from this page.</p>
</form>
</Base>

<script>
  // The answers as text, sent as a GitHub issue or an email. Nothing leaves the
  // page until you send it there.
  const REPO = "https://github.com/francesco-di-maggio/clessidra/issues/new";
  const ADDRESS = "f.di.maggio@tue.nl";
  const form = document.getElementById("feedback") as HTMLFormElement;

  function text() {
    const data = new FormData(form);
    return `Played on: ${data.get("where")}\n\n${String(data.get("feedback") ?? "").trim()}`;
  }
  const title = () => `Feedback: ${String(new FormData(form).get("feedback") ?? "").trim().slice(0, 60)}`;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = new URLSearchParams({ labels: "feedback", title: title(), body: text() });
    open(`${REPO}?${q}`, "_blank", "noopener");
  });
  document.getElementById("email")!.addEventListener("click", () => {
    if (!form.reportValidity()) return;
    location.href = `mailto:${ADDRESS}?subject=${encodeURIComponent(title())}&body=${encodeURIComponent(text())}`;
  });
</script>
