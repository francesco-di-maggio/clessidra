---
// The link image, 1200 × 630, as Home: the logo, the line, the board's name,
// beside the hourglass half poured, dust behind. Rendered to public/og.png by
// web/images.mjs, not linked from the site.
import "@fontsource/barlow-semi-condensed/600.css";
import { css, matrix } from "../lib/tokens";

const logo = matrix([..."CLESSIDRA"], "var(--accent)", 'class="logo"');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>Clessidra</title>
<style is:inline set:html={css()}></style>
<style is:global>
  html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: var(--bg); color: var(--ink); font-family: var(--sans); }
  .dust { position: absolute; inset: 0; width: 1200px; height: 630px; }
  .text { position: absolute; left: 96px; top: 50%; transform: translateY(-50%); width: 720px; display: grid; gap: 36px; }
  .logo { width: 560px; height: auto; display: block; }
  p { margin: 0; font-size: 42px; line-height: 54px; font-weight: 600; text-wrap: balance; }
  .label { font-size: 28px; line-height: 36px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .clock { position: absolute; right: 120px; top: 95px; width: 200px; height: 440px; --band: 200px; }
</style>
</head>
<body>
<canvas class="dust"></canvas>
<div class="text">
  <Fragment set:html={logo} />
  <p>A real-time granular sampler for stretching, freezing and slicing time.</p>
  <span class="label">Francesco Di Maggio · Synthux Residency 2026</span>
</div>
<canvas id="clock" class="clock"></canvas>
<script>
  import { Hourglass } from "../lib/hourglass";
  import { PARAM, PARAM_SIZE } from "../lib/engine";
  import { fall } from "../lib/grains";
  fall(document.querySelector<HTMLCanvasElement>(".dust")!);
  const glass = new Hourglass(document.getElementById("clock") as HTMLCanvasElement, true);
  const params = new Float32Array(PARAM_SIZE);
  params[PARAM.speed] = 20;
  params[PARAM.density] = 320;
  params[PARAM.heading] = 1;
  params[PARAM.sandLeft] = 0.55;
  glass.update(params, true);
</script>
</body>
</html>
