---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base title="Not Found">
<div class="head">
  <h1>Not Found</h1>
  <p class="lead">No page here.</p>
</div>
<section class="sect">
  <h2 class="label">Go to</h2>
  <ul class="links-list">
    <li><a href={url()}><span class="text"><b>Home</b></span><span class="arrow" aria-hidden="true">→</span></a></li>
  </ul>
</section>
</Base>
