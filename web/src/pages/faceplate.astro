---
import Base from "../layouts/Base.astro";
import { COLOUR, FONT } from "../lib/tokens";
import faceplate from "../../../faceplate/clessidra-faceplate.svg?raw";
import pdf from "../../../faceplate/clessidra-faceplate.pdf?url";
import svg from "../../../faceplate/clessidra-faceplate.svg?url";

const art = faceplate.replace(/^<\?xml[^>]*>\s*/, "").replace("<svg ", '<svg role="img" aria-label="The Clessidra faceplate" ');
const c = COLOUR.black;
const swatches = [
  ["Plate", c.bg],
  ["Gold", c.accent],
  ["Tan", c.twin],
  ["Well", c.well],
];
const font = FONT.split(",")[0].replace(/"/g, "");
---
<Base title="Faceplate" description="Clessidra's faceplate for the Simple Touch 2: the art, its colours and its type.">
<div class="head">
  <h1>Faceplate</h1>
  <p class="lead">The panel over the Simple Touch 2, printed at 100%.</p>
</div>
<figure class="art"><Fragment set:html={art} /></figure>

<section class="sect">
  <h2 class="label">Colours</h2>
  <ul class="swatches">
    {swatches.map(([name, hex]) => <li class="swatch" style={`--c: ${hex}`}><b>{name}</b><code>{hex}</code></li>)}
  </ul>
</section>

<section class="sect">
  <h2 class="label">Type</h2>
  <ol class="rows type">
    <li class="row"><span class="label">Name</span><span class="name">Size</span></li>
    <li class="row"><span class="label">Second</span><span class="label second">Grit</span></li>
    <li class="row"><span class="label">Font</span><span>{font}, 700 and 600, capitals tracked 0.1 em. Names 2 mm, second names 1.5 mm (1.33 times smaller).</span></li>
  </ol>
</section>

<section class="sect">
  <h2 class="label">Hardware</h2>
  <dl class="meta">
    <dt class="label">Board</dt><dd><a href="https://www.synthux.academy/">Synthux Simple Touch 2</a></dd>
    <dt class="label">Core</dt><dd><a href="https://daisy.audio/">Electrosmith Daisy Seed</a></dd>
    <dt class="label">Made at</dt><dd><a href="https://www.synthux.academy/residency">Synthux Design Residency 2026</a></dd>
    <dt class="label">Licence</dt><dd>MIT</dd>
  </dl>
</section>

<section class="sect">
  <h2 class="label">Files</h2>
  <ul class="links-list">
    <li><a href={pdf} download="clessidra-faceplate.pdf"><span class="text"><b>Print</b><span class="sub">PDF, A4 at 100%</span></span><span class="arrow" aria-hidden="true">↓</span></a></li>
    <li><a href={svg} download="clessidra-faceplate.svg"><span class="text"><b>Art</b><span class="sub">SVG, text as text</span></span><span class="arrow" aria-hidden="true">↓</span></a></li>
  </ul>
</section>
</Base>
