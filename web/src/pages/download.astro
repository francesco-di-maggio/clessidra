---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
import print from "../../../faceplate/clessidra-faceplate-print.pdf?url";

// A file's icon: a page with its type on it
const icon = (type: string) => `<svg class="file" viewBox="0 0 24 24" aria-label="${type}"><path d="M6 2.5h8l4.5 4.5v14.5h-12.5z M14 2.5v4.5h4.5" /><text x="12" y="17.5">${type}</text></svg>`;
const files = [
  { href: "https://github.com/francesco-di-maggio/clessidra/releases/latest/download/clessidra.bin", name: "Firmware", sub: "The latest release", type: "BIN", file: "clessidra.bin" },
  { href: url("clessidra-manual.pdf"), name: "Manual", sub: "A4, 2 pages", type: "PDF", file: "clessidra-manual.pdf" },
  { href: print, name: "Faceplate", sub: "A4 at 100%", type: "PDF", file: "clessidra-faceplate.pdf" },
];
---
<Base title="Download" description="Clessidra's firmware for the Synthux Simple Touch 2, how to flash it, its manual and faceplate.">
<div class="head">
  <h1>Download</h1>
  <p class="lead">Firmware for the Synthux Simple Touch 2, flashed over USB.</p>
</div>

<section class="sect">
  <h2 class="label">Steps</h2>
  <ol class="rows tight">
    <li class="row"><span class="label">1</span><span>Download the <a href="https://github.com/francesco-di-maggio/clessidra/releases/latest/download/clessidra.bin">Firmware</a>, or an earlier one from <a href="https://github.com/francesco-di-maggio/clessidra/releases">Releases</a>.</span></li>
    <li class="row"><span class="label">2</span><span>Connect the Seed over USB.</span></li>
    <li class="row"><span class="label">3</span><span>Hold BOOT, tap RESET, then release BOOT.</span></li>
    <li class="row"><span class="label">4</span><span>Flash it on the <a href="https://flash.daisy.audio/">Daisy Web Programmer</a>, from Chrome or Edge.</span></li>
  </ol>
</section>

<section class="sect">
  <h2 class="label">Files</h2>
  <ul class="cards">
    {files.map((f) => <li><a class="card" href={f.href} download={f.file}><span class="text"><b>{f.name}</b><span class="sub">{f.sub}</span></span><Fragment set:html={icon(f.type)} /></a></li>)}
  </ul>
</section>
</Base>
