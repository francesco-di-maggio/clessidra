---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
import "../styles/play.css";
---
<Base title="Play" app description="Clessidra in your browser: the same firmware as the board, no board needed.">
  <link slot="head" rel="preload" href={url("clessidra.wasm")} as="fetch" type="application/wasm" crossorigin />
  <div class="instrument">
    <section class="tile transport" aria-label="Source and output level">
      <button id="start" class="control primary" type="button">Start</button>
      <span class="divider"></span>
      <div id="input" class="segmented" role="group" aria-label="Input">
        <button type="button" data-input="demo" aria-pressed="true">Demo</button>
        <button type="button" data-input="mic" aria-pressed="false">Mic</button>
        <button type="button" data-input="file" aria-pressed="false">File</button>
      </div>
      <input id="file" type="file" accept="audio/*" hidden>
      <div id="levels" class="levels" aria-label="Output level, browser only"></div>
      <span class="divider"></span>
      <span id="led" class="led" role="img" aria-label="The board's LED"></span>
    </section>

    <section class="tile sound" aria-label="The input and the recording">
      <div class="input">
        <canvas id="incoming" role="img" aria-label="The input over the last 8 s, the part being recorded in orange"></canvas>
        <span id="monitor" class="figure on"></span>
      </div>
      <canvas id="buffer" role="img" aria-label="The recording: the loop, its slices, the playhead, the reach of Spray, and each grain where it reads, as high as its pitch, as big as its size"></canvas>
    </section>

    <section class="tile controls" aria-label="Faders, knobs and switches, as on the board">
      <div id="speed" aria-label="Speed"></div>
      <div class="knobs">
        <div id="k-S31" class="cell"></div>
        <div id="k-S32" class="cell"></div>
        <div id="k-S33" class="cell"></div>
        <div id="k-S34" class="cell"></div>
        <div id="k-S30" class="cell"></div>
        <div class="knob glass">
          <canvas id="glass" role="img" aria-label="An hourglass: the loop still ahead of the playhead above, what has played below"></canvas>
        </div>
        <div id="k-S35" class="cell"></div>
      </div>
      <div id="density" aria-label="Density"></div>
    </section>

    <section class="tile pads" aria-label="The switches, then the pads in the board's order: Record, Shift, Stop, Reset and Trigger over the slices">
      <div class="switches">
        <div id="s09"></div>
        <div id="s07"></div>
      </div>
      <div class="pad-rows">
        <div id="functions" class="pad-row functions"></div>
        <div id="slices" class="pad-row slices"></div>
      </div>
    </section>
  </div>
</Base>

<script>
  import "../lib/play";
</script>
