---
import Base from "../layouts/Base.astro";
import "../styles/play.css";
---
<Base title="Play" app description="Clessidra in the browser: the firmware as WebAssembly.">
  <span slot="end" class="label led">LED <span id="led" class="dot"></span></span>

  <div class="split">
    <div class="transport">
      <button id="start" class="control primary" type="button">Start</button>
      <div id="input" class="segmented" role="group" aria-label="Input">
        <button type="button" data-input="demo" aria-pressed="true">Demo</button>
        <button type="button" data-input="mic" aria-pressed="false">Mic</button>
        <button type="button" data-input="file" aria-pressed="false">File</button>
      </div>
      <input id="file" type="file" accept="audio/*" hidden>
    </div>
    <section id="levels" class="panel levels" aria-label="Input and output level, browser only"></section>
  </div>

  <div class="split scope">
    <section class="panel incoming" aria-label="Incoming: what a tap keeps">
      <div id="tap" class="segmented tap" role="radiogroup" aria-label="A tap keeps"></div>
      <canvas id="incoming" role="img" aria-label="The input over the seconds a tap keeps"></canvas>
    </section>
    <section class="panel grain" aria-label="A grain">
      <canvas id="grain-view" role="img" aria-label="A grain's window at its size, and the range randomness reaches"></canvas>
    </section>
  </div>

  <section class="panel view" aria-label="Buffer">
    <span id="held" class="label held">Empty</span>
    <canvas id="buffer" role="img" aria-label="The recording: the selection, the playhead, the slices and the grains"></canvas>
  </section>

  <div class="rack" aria-label="Speed, the sand, the grain and Density">
    <section id="speed" class="panel edge"></section>
    <section class="panel knobs"><div id="selection" class="group"></div><i class="divider"></i><div id="grain" class="group"></div></section>
    <section id="flow" class="panel edge"></section>
  </div>

  <div class="deck" aria-label="The switches and the 12 pads">
    <section class="panel keys-tile"><div id="keys" class="keys"></div></section>
    <section id="end" class="panel side"></section>
  </div>

  <p class="panel readout" aria-live="polite"><span id="readout-name" class="label"></span><span id="readout-value" class="value"></span><span id="readout-does" class="does"></span></p>
</Base>

<script>
  import "../lib/play";
</script>
