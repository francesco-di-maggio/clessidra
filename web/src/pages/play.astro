---
import Base from "../layouts/Base.astro";
import "../styles/play.css";
---
<Base title="Play" app description="Clessidra in the browser: the firmware as WebAssembly.">
  <Fragment slot="end">
    <div class="transport">
      <button id="start" class="control primary" type="button">Start</button>
      <div id="input" class="segmented" role="group" aria-label="Input">
        <button type="button" data-input="demo" aria-pressed="true">Demo</button>
        <button type="button" data-input="mic" aria-pressed="false">Mic</button>
        <button type="button" data-input="file" aria-pressed="false">File</button>
      </div>
      <input id="file" type="file" accept="audio/*" hidden>
    </div>
    <div id="levels" class="levels" aria-label="Input and output level, browser only"></div>
    <span class="label led" title="The board's LED">LED <span id="led" class="dot"></span></span>
  </Fragment>

  <div class="instrument">
    <section class="tile buffer" aria-label="Recording">
      <span class="label tag">Recording</span>
      <span id="held" class="figure held">Empty</span>
      <canvas id="buffer" role="img" aria-label="The recording: the selection, the playhead and the grains"></canvas>
    </section>

    <section class="tile glass" aria-label="Hourglass">
      <span class="label tag">Hourglass</span>
      <canvas id="hourglass" role="img" aria-label="The hourglass: the sand left, the grains falling, the sand fallen, the neck clogging"></canvas>
      <dl class="facts">
        <dt>Sand left</dt><dd id="glass-sand">–</dd>
        <dt>Voices</dt><dd id="glass-voices">0/32</dd>
        <dt>Clogged</dt><dd id="glass-clog">0/s</dd>
      </dl>
    </section>

    <section class="tile incoming" aria-label="Input: what a tap keeps">
      <span class="label tag">Input</span>
      <div id="tap" class="segmented tap" role="radiogroup" aria-label="A tap keeps"></div>
      <canvas id="incoming" role="img" aria-label="The input over the seconds a tap keeps"></canvas>
    </section>

    <section class="tile grain" aria-label="Grain">
      <span class="label tag">Grain</span>
      <canvas id="grain-view" role="img" aria-label="A grain's window at its size, and the range randomness reaches"></canvas>
    </section>

    <section id="speed" class="tile fader" aria-label="Speed"></section>

    <section class="tile knobs" aria-label="Knobs and switches, as on the board">
      <div id="k-S31" class="cell"></div>
      <div id="k-S32" class="cell"></div>
      <div id="k-S33" class="cell"></div>
      <div id="k-S34" class="cell"></div>
      <div id="k-S30" class="cell"></div>
      <div id="s09" class="cell wide"></div>
      <div id="end" class="cell wide"></div>
      <div id="k-S35" class="cell"></div>
    </section>

    <section id="density" class="tile fader" aria-label="Density"></section>

    <section class="tile keys-tile" aria-label="The 12 pads"><div id="keys" class="keys"></div></section>

    <p class="tile readout" aria-live="polite"><span id="readout-name" class="label"></span><span id="readout-value" class="value"></span><span id="readout-does" class="does"></span></p>
  </div>
</Base>

<script>
  import "../lib/play";
</script>
