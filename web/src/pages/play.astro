---
import Base from "../layouts/Base.astro";
import "../styles/play.css";
---
<Base title="Play" app description="Play Clessidra in the browser: the firmware compiled to WebAssembly, its controls and every grain.">
  <span slot="end" class="label led">LED <span id="led" class="dot"></span></span>

  <div class="bar">
    <button id="start" class="control" type="button">Start</button>
    <div id="input" class="segmented" role="group" aria-label="Input">
      <button type="button" data-input="demo" aria-pressed="false" disabled>Demo</button>
      <button type="button" data-input="mic" aria-pressed="false" disabled>Mic</button>
      <button type="button" data-input="file" aria-pressed="false" disabled>File</button>
    </div>
    <input id="file" type="file" accept="audio/*" hidden>
  </div>

  <section class="panel view" aria-label="Sand">
    <div class="head"><span class="label">Sand</span><span id="held" class="label held">Empty</span></div>
    <canvas id="sand" role="img" aria-label="The recording: the selection, the playhead, the slices and the grains"></canvas>
  </section>

  <div class="rack">
    <section class="panel group record" aria-label="Record" id="record"></section>
    <section class="panel group time" aria-label="Time" id="time"></section>
    <section class="panel group selection" aria-label="Selection" id="selection"></section>
    <section class="panel group grain" aria-label="Grain" id="grain"></section>
    <section class="panel group output" aria-label="Output" id="output"></section>
    <section class="panel group slices pads" aria-label="Slices" id="slices"></section>
  </div>

  <p class="readout" aria-live="polite"><span id="readout-name" class="label"></span><span id="readout-value" class="value"></span><span id="readout-does" class="does"></span></p>
</Base>

<script>
  import "../lib/play";
</script>
