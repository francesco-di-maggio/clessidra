---
import Base from "../layouts/Base.astro";
import "../styles/play.css";
---
<Base title="Play" app description="Clessidra in the browser: the firmware as WebAssembly.">
  <Fragment slot="end">
    <span class="label led" title="The board's LED">LED <span id="led" class="dot"></span></span>
  </Fragment>

  <div class="instrument">
    <section class="tile transport" aria-label="Source and levels">
      <span class="label name">Source</span>
      <button id="start" class="control primary" type="button">Start</button>
      <div id="input" class="segmented" role="group" aria-label="Input">
        <button type="button" data-input="demo" aria-pressed="true">Demo</button>
        <button type="button" data-input="mic" aria-pressed="false">Mic</button>
        <button type="button" data-input="file" aria-pressed="false">File</button>
      </div>
      <input id="file" type="file" accept="audio/*" hidden>
      <div id="levels" class="levels" aria-label="Input and output level, browser only"></div>
    </section>

    <section class="tile input" aria-label="The input">
      <span class="label name">Input</span>
      <canvas id="incoming" role="img" aria-label="The input over the last 8 s, the part being recorded in orange"></canvas>
      <span id="monitor" class="figure on"></span>
    </section>

    <section class="tile sound" aria-label="The recording">
      <div class="bar">
        <span class="label">Recording</span>
        <span class="figures"><span id="grain-figure" class="figure" title="Grain size, grains sounding of the voices">100 ms · 0/32</span><span id="held" class="figure">Empty</span></span>
      </div>
      <canvas id="buffer" role="img" aria-label="The recording: the loop, its slices, a click on one plays it, the playhead, the reach of Random position, and each grain where it reads, as high as its pitch, as big as its size"></canvas>
    </section>

    <section id="speed" class="tile fader" aria-label="Speed"></section>

    <section class="tile knobs" aria-label="Knobs and switches, as on the board">
      <div id="k-S31" class="cell"></div>
      <div id="k-S32" class="cell"></div>
      <div id="k-S33" class="cell"></div>
      <div id="k-S34" class="cell"></div>
      <div id="k-S30" class="cell"></div>
      <div id="s09" class="cell"></div>
      <div id="s07" class="cell"></div>
      <div id="k-S35" class="cell"></div>
    </section>

    <section id="density" class="tile fader" aria-label="Density"></section>

    <section class="tile pads" aria-label="The pads: Rec, Shift, Stop, Reset and Cue. The slices are in the recording.">
      <div id="functions" class="functions"></div>
    </section>
  </div>
</Base>

<script>
  import "../lib/play";
</script>
