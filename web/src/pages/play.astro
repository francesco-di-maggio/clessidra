---
import Base from "../layouts/Base.astro";
import "../styles/play.css";
---
<Base title="Play" app description="Play Clessidra in the browser: the firmware compiled to WebAssembly, its controls and every grain.">
  <span slot="end" class="label led">LED <span id="led" class="dot"></span></span>

  <div class="transport">
    <button id="start" class="control primary" type="button">Start</button>
    <div id="record"></div>
    <div id="input" class="segmented" role="group" aria-label="Input">
      <button type="button" data-input="demo" aria-pressed="true">Demo</button>
      <button type="button" data-input="mic" aria-pressed="false">Mic</button>
      <button type="button" data-input="file" aria-pressed="false">File</button>
    </div>
    <input id="file" type="file" accept="audio/*" hidden>
  </div>

  <section class="panel io" aria-label="Input and output">
    <div id="io-in" class="end"></div>
    <canvas id="incoming" role="img" aria-label="The input over the last 8 seconds"></canvas>
    <div id="io-out" class="end"></div>
  </section>

  <section class="panel view" aria-label="Buffer">
    <span id="held" class="label held">Empty</span>
    <canvas id="buffer" role="img" aria-label="The recording: the selection, the playhead, the slices and the grains"></canvas>
  </section>

  <section class="panel strip" aria-label="Knobs, in the order the sound goes, P11's layer below each">
    <div class="cluster"><span class="head">Playhead</span><div id="playhead" class="body"></div></div>
    <div class="cluster"><span class="head">Grain</span><div id="grain" class="body"></div></div>
    <div class="cluster"><span class="head">FX</span><div id="fx" class="body"></div></div>
    <div class="cluster"><span class="head">Mix</span><div id="mix" class="body"></div></div>
  </section>
  <section class="panel pads" aria-label="Switches and pads">
    <div id="switches" class="group" aria-label="Switches and restart"></div>
    <div class="column wide"><span class="label">Slices</span><div id="slices" class="slices" aria-label="Slices"></div></div>
  </section>

  <p class="readout" aria-live="polite"><span id="readout-name" class="label"></span><span id="readout-value" class="value"></span><span id="readout-does" class="does"></span></p>
</Base>

<script>
  import "../lib/play";
</script>
