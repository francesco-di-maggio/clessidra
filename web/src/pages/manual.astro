---
// The manual, two A4 pages in the style of Synthux's blank manual: the panel
// with every control's name, then what each does. Printed to
// clessidra-manual.pdf by web/manual.mjs.
import "../styles/tokens.css";
import "../styles/site.css";
import TouchPanel from "../components/TouchPanel.astro";
import { CONTROLS, LED } from "../lib/controls";

const KNOBS = ["S36", "S37", "S30", "S35", "S31", "S32", "S33", "S34"];
const byId = (id: string) => CONTROLS.find((c) => c.id === id)!;
const OTHERS = ["S09", "S07", "P10", "P00", "P01", "P02", "P03", "P04", "P08", "P05", "P06", "P09", "P07", "P11"];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<title>Clessidra · Manual</title>
<style>
  @page { size: A4; margin: 0; }
  html, body { margin: 0; background: #fff; color: #111; font: 10pt/1.4 var(--sans); }
  .page { box-sizing: border-box; width: 210mm; height: 297mm; padding: 10mm; break-after: page; }
  .frame { box-sizing: border-box; height: 100%; border: 0.3mm solid #111; padding: 14mm 16mm; display: flex; flex-direction: column; }
  .title { display: grid; grid-template-columns: auto 1fr; column-gap: 8mm; align-items: center; margin: 0 6mm; }
  .glass { width: 16mm; height: 22mm; }
  .glass path { fill: none; stroke: #111; stroke-width: 1.2; }
  .kicker { font-size: 18pt; font-weight: 300; color: #777; }
  h1 { margin: 0; font-size: 38pt; font-weight: 400; letter-spacing: -0.01em; line-height: 1; }
  .lines { margin: 8mm 6mm 0 30mm; }
  .lines p { margin: 0; padding: 2.4mm 0; border-bottom: 0.25mm solid #111; font-size: 10pt; }
  .board { flex: 1; min-height: 0; display: flex; justify-content: center; padding: 8mm 0; }
  .board svg.touch { width: auto; height: 100%; max-height: none; margin: 0; }
  .touch .plate { fill: #fff; }
  .box { border: 0.3mm solid #111; padding: 3mm 6mm; margin: 0 8mm; }
  .box p { margin: 0; padding: 2mm 0; border-bottom: 0.25mm solid #111; }
  .box p:last-child { border-bottom: 0; }
  h2 { margin: 0 0 3mm; font: 500 8pt var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: #777; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 5mm; font-size: 8.5pt; line-height: 1.3; }
  th { text-align: left; font: 500 7pt var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: #777; padding: 0 2mm 1.5mm 0; border-bottom: 0.3mm solid #111; }
  td { padding: 1mm 2mm 1mm 0; border-bottom: 0.2mm solid #ccc; vertical-align: top; }
  td:first-child { font: 500 8.5pt var(--mono); white-space: nowrap; width: 18mm; }
  td.free { color: #aaa; }
  .touch { --ink: #111; --dim: #777; --line: #bbb; --surface: #fff; --accent: #111; }
</style>
</head>
<body>
<section class="page"><div class="frame">
  <div class="title">
    <svg class="glass" viewBox="-9 -12 18 24" aria-hidden="true"><path d="M-6-10h12M-6 10h12M-4.5-10C-4.5-3.5-1-2-1 0S-4.5 3.5-4.5 10M4.5-10C4.5-3.5 1-2 1 0S4.5 3.5 4.5 10"/></svg>
    <div><div class="kicker">Simple Touch</div><h1>Clessidra</h1></div>
  </div>
  <div class="lines">
    <p>It's the instrument where you pour grains of sound from single drops into a dense cloud.</p>
    <p>francescodimaggio.nl/clessidra</p>
    <p>Synthux Design Residency 2026</p>
  </div>
  <div class="board"><TouchPanel /></div>
  <div class="box">
    <p>One layer: every control does one thing, where it is.</p>
    <p>The selection is the sand. Speed sets how fast it runs through, Density how it falls.</p>
    <p>Speed at its centre holds the playhead.</p>
  </div>
</div></section>

<section class="page"><div class="frame">
  <h2>Faders and Knobs</h2>
  <table>
    <tbody>
      {KNOBS.map(byId).map((c) => <tr><td>{c.id}</td><td><b>{c.name}</b>. {c.does}</td></tr>)}
    </tbody>
  </table>

  <h2>Pads and Switches</h2>
  <table>
    <tbody>
      {OTHERS.map(byId).map((c) => <tr><td>{c.id}</td><td><b>{c.name}</b>. {c.does}</td></tr>)}
    </tbody>
  </table>

  <h2>LED</h2>
  <table>
    <tbody>{LED.map(([state, meaning]) => <tr><td>{state}</td><td>{meaning}</td></tr>)}</tbody>
  </table>
</div></section>
</body>
</html>
