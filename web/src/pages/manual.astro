---
// The manual's text, on Synthux's Touch II blank manual (web/templates/). Page
// 1: the name, each control's line beside the panel, the box below left for
// notes. Page 2: what each control does, ways to play, the LED. In the
// template's points, A4, transparent: web/manual.mjs prints it and lays it
// over the template, into clessidra-manual.pdf.
import { CONTROLS, LED, PLAY, byId } from "../lib/controls";

const W = 595.276;
const H = 841.89;
// The template's panel, measured: its edges, and the board photo's pixels
// (controls.ts) onto it, fitted to the drawn knobs
const PANEL = { left: 195.9, right: 398.9 };
const at = (x: number, y: number): [number, number] => [200.1 + 0.3275 * x, 280.9 + 0.335 * y];
// The drawn jacks and faders
const SPOTS: Record<string, [number, number]> = { IN: [209, 323.8], OUT: [209, 362.4], S36: [209, 427], S37: [385.6, 427] };
// Switches: the code under the lever
const spot = (id: string): [number, number] => {
  if (SPOTS[id]) return SPOTS[id];
  const c = byId(id);
  const [x, y] = at(c.x, c.y);
  return c.type === "switch" ? [x, y + 11] : [x, y];
};

// Lines beside the panel: the code, then what it does, the twin in grey
// under it. Heights are the leader's, in points.
interface Line { id: string; y: number; text: string; twin?: string }
const line = (id: string, y: number, label = id): Line => {
  const c = byId(id);
  return { id: label, y, text: c.brief ?? c.name, twin: c.twin?.brief };
};
const LEFT: Line[] = [
  line("P10", 297.6),
  { id: "IN", y: 323.8, text: "Input" },
  { id: "OUT", y: 362.4, text: "Output" },
  line("S31", 390),
  line("S32", 414),
  line("S36", 438),
  line("S30", 462),
  line("P00", 488.6),
  line("S09", 503),
  line("P03", 548.9, "P03–P09"),
];
const RIGHT: Line[] = [
  line("P11", 297.6),
  line("S33", 390),
  line("S34", 414),
  line("S37", 438),
  line("S35", 462),
  line("P01", 485.2),
  line("P02", 497.2),
  line("S07", 513),
];
const CODE = 3.6; // a code's character, 6 pt mono
const codeEnd = PANEL.left - 16;
const codeStart = PANEL.right + 16;

const CHIPS = [...CONTROLS.map((c) => c.id), "IN", "OUT"];

// The template's rules under the name
const TITLE = { x: 196, rules: [134.3, 153.1, 171.9] };

const KNOBS = ["S36", "S37", "S30", "S35", "S31", "S32", "S33", "S34"].map(byId);
const OTHERS = ["S09", "S07", "P10", "P11", "P00", "P01", "P02"].map(byId);
const SLICES = byId("P03");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Clessidra · Manual</title>
<link rel="stylesheet" href="https://francescodimaggio.nl/style/v1/tokens.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;400&display=block">
<style>
  @page { size: A4; margin: 0; }
  html, body { margin: 0; background: transparent; }
  svg { display: block; width: 210mm; height: 297mm; break-after: page; }
  text { font-family: var(--sans); fill: #111; }
  .name { font-size: 9.5px; font-weight: 600; }
  .kicker, .title { font-family: "Outfit", var(--sans); }
  .kicker { font-size: 19.6px; font-weight: 200; fill: #8a8a8a; }
  .title { font-size: 36px; font-weight: 400; letter-spacing: -0.2px; }
  .sub { font-size: 8px; }
  .url, .code, .chip text { font-family: var(--mono); }
  .url { font-size: 6.5px; fill: #777; }
  .code { font-size: 6px; font-weight: 600; }
  .does { font-size: 6.5px; }
  .twin { font-size: 6px; fill: #888; }
  .leader { stroke: #111; stroke-width: 0.5; }
  .chip rect { fill: #111; }
  .chip text { font-size: 4.6px; font-weight: 600; fill: #fff; text-anchor: middle; }
  .page { box-sizing: border-box; width: 210mm; height: 297mm; padding: 60pt 56pt; font: 7pt/1.35 var(--sans); color: #111; text-wrap: pretty; }
  h2 { margin: 0 0 3pt; font: 600 6pt var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: #888; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 14pt; }
  td { padding: 3pt 6pt 3pt 0; border-bottom: 0.5pt solid #111; vertical-align: top; }
  td:first-child { width: 58pt; font: 600 6pt/1.6 var(--mono); }
  .second { color: #888; }
</style>
</head>
<body>
<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg">
  <!-- The template's heading, Touch II over Blank Manual, covered and set
       again with the instrument's name, on the same lines -->
  <rect x="188" y="56" width="226" height="58" fill="#fff" />
  <text class="kicker" x="192.5" y="76.8">Touch II</text>
  <text class="title" x="194" y="108.2">Clessidra</text>
  <text class="sub" x={TITLE.x} y={TITLE.rules[0] - 4}>A real-time granular sampler inspired by the hourglass.</text>
  <text class="sub" x={TITLE.x} y={TITLE.rules[1] - 4}>By Francesco Di Maggio</text>
  <text class="url" x={TITLE.x} y={TITLE.rules[2] - 4}>v0.3 · francescodimaggio.nl/clessidra</text>

  {CHIPS.map((id) => {
    const [x, y] = spot(id);
    const w = id.length * 2.9 + 4;
    return <g class="chip"><rect x={x - w / 2} y={y - 3.6} width={w} height={7.2} rx={3.6} /><text x={x} y={y + 1.6}>{id}</text></g>;
  })}

  {LEFT.map((l) => {
    const textEnd = codeEnd - l.id.length * CODE - 4;
    return (
      <g>
        <line class="leader" x1={codeEnd + 3} y1={l.y} x2={PANEL.left} y2={l.y} />
        <text class="code" x={codeEnd} y={l.y + 2.1} text-anchor="end">{l.id}</text>
        <text class="does" x={textEnd} y={l.y + 2.3} text-anchor="end">{l.text}</text>
        {l.twin && <text class="twin" x={textEnd} y={l.y + 10.3} text-anchor="end">{l.twin}</text>}
      </g>
    );
  })}
  {RIGHT.map((l) => {
    const textStart = codeStart + l.id.length * CODE + 4;
    return (
      <g>
        <line class="leader" x1={PANEL.right} y1={l.y} x2={codeStart - 3} y2={l.y} />
        <text class="code" x={codeStart} y={l.y + 2.1}>{l.id}</text>
        <text class="does" x={textStart} y={l.y + 2.3}>{l.text}</text>
        {l.twin && <text class="twin" x={textStart} y={l.y + 10.3}>{l.twin}</text>}
      </g>
    );
  })}

</svg>

<section class="page">
  <h2>Faders and knobs</h2>
  <table>
    {KNOBS.map((c) => <tr><td>{c.id}</td><td><b>{c.name}</b>. {c.does}{c.twin && <><br /><span class="second"><b>{c.twin.name}</b>. {c.twin.does}</span></>}</td></tr>)}
  </table>
  <h2>Pads and switches</h2>
  <table>
    {OTHERS.map((c) => <tr><td>{c.id}</td><td><b>{c.name}</b>. {c.does}{c.twin && <><br /><span class="second"><b>{c.twin.name}</b>. {c.twin.does}</span></>}</td></tr>)}
    <tr><td>P03–P09</td><td><b>Slices</b>. {SLICES.does}</td></tr>
  </table>
  <h2>To play</h2>
  <table>
    {PLAY.map(([sound, how]) => <tr><td>{sound}</td><td>{how}</td></tr>)}
  </table>
  <h2>LED</h2>
  <table>
    {LED.map(([state, meaning]) => <tr><td>{state}</td><td>{meaning}</td></tr>)}
  </table>
</section>
</body>
</html>
