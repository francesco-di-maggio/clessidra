---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base>
<h1>Clessidra</h1>
<p class="lead">It's the instrument where you pour grains of sound from single drops into a dense cloud.</p>

<h2 class="label">About</h2>
<section class="panel">
  <div class="prose"><p>A granular instrument inspired by the hourglass. It explores the slow emptying of the glass and the fast trickle of single grains. It lets you capture and bend time through sound, slowing it down, speeding it up, reversing it or freezing it. Broken grains, like sand, are gathered and pieced back together, never quite the same and never fully still.</p></div>
</section>

<div class="status">
<dl class="panel meta">
  <dt>Status</dt><dd class="live">In progress</dd>
  <dt>Made at</dt><dd><a href="https://www.synthux.academy/residency">Synthux Design Residency 2026</a></dd>
  <dt>Hardware</dt><dd><a href="https://www.synthux.academy/">Synthux Simple Touch</a>, <a href="https://daisy.audio/">Electrosmith Daisy Seed</a></dd>
  <dt>Licence</dt><dd>MIT</dd>
</dl>
<div class="clock" role="img" aria-label="The time now, as sand through a minute">
  <svg viewBox="-6.5 -8.1 13 16.2" aria-hidden="true">
    <clipPath id="clock-above"><path d="M-4-7.5C-4-2.5-1-1.5-1 0H1C1-1.5 4-2.5 4-7.5Z" /></clipPath>
    <clipPath id="clock-below"><path d="M-4 7.5C-4 2.5-1 1.5-1 0H1C1 1.5 4 2.5 4 7.5Z" /></clipPath>
    <rect id="clock-left" class="sand" x="-5" width="10" clip-path="url(#clock-above)" />
    <rect id="clock-gone" class="sand" x="-5" width="10" clip-path="url(#clock-below)" />
    <circle id="clock-grain" class="sand grain" r="0.75" />
    <path class="glass" d="M-5.5-7.5h11M-5.5 7.5h11M-4-7.5C-4-2.5-1-1.5-1 0S-4 2.5-4 7.5M4-7.5C4-2.5 1-1.5 1 0S4 2.5 4 7.5" />
  </svg>
  <time id="clock-time" class="label"></time>
</div>
</div>

<div class="tiles" style="--above: 580px">
  <a id="listen" class="panel" href={url("clessidra-target.m4a")}>
    <span class="text"><b>Listen</b><span class="sub" id="listen-time">0:30</span></span>
    <span class="arrow" aria-hidden="true">▶</span>
  </a>
  <a class="panel primary" href="play/">
    <span class="text"><b>Play</b><span class="sub">The same firmware in your browser. No board needed.</span></span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>
</Base>

<script>
  // The clock: the minute as sand. Each second a grain falls from the neck,
  // so the bulb above holds what is left of the minute and the one below
  // fills with what has passed. On the minute it starts over. The time under
  // the glass.
  const BULB = 7.5; // a bulb's height in the drawing
  const left = document.getElementById("clock-left")!;
  const gone = document.getElementById("clock-gone")!;
  const now = document.getElementById("clock-time") as HTMLTimeElement;
  const grain = document.getElementById("clock-grain")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)");
  function tick() {
    const d = new Date();
    const passed = d.getSeconds() / 60;
    // Above, the sand rests on the neck. Below, on the base.
    left.setAttribute("y", String(-BULB * (1 - passed)));
    left.setAttribute("height", String(BULB * (1 - passed)));
    gone.setAttribute("y", String(BULB * (1 - passed)));
    gone.setAttribute("height", String(BULB * passed));
    const text = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
    now.textContent = text;
    now.dateTime = text;
    // Down to the sand below, faster as it goes
    const fall = Math.max(BULB * (1 - passed) - 0.75, 0);
    if (!still.matches) grain.animate([{ opacity: 1, transform: "translateY(0)" }, { opacity: 1, transform: `translateY(${fall}px)` }], { duration: 700, easing: "ease-in" });
  }
  // On the second, as a clock ticks
  tick();
  setTimeout(() => (tick(), setInterval(tick, 1000)), 1000 - new Date().getMilliseconds());
</script>

<script>
  // The target sound, played in the page: a press starts it, another stops it
  const link = document.getElementById("listen") as HTMLAnchorElement;
  const time = document.getElementById("listen-time")!;
  const arrow = link.querySelector(".arrow")!;
  const audio = new Audio();
  audio.preload = "none";
  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  const total = time.textContent!;
  const show = () => {
    const playing = !audio.paused && !audio.ended;
    arrow.textContent = playing ? "■" : "▶";
    link.classList.toggle("on", playing);
    time.textContent = playing ? `${clock(audio.currentTime)} of ${total}` : total;
  };
  link.addEventListener("click", (e) => {
    e.preventDefault();
    if (!audio.src) audio.src = link.href;
    if (audio.paused) {
      audio.currentTime = 0;
      audio.play();
    } else audio.pause();
  });
  for (const event of ["play", "pause", "ended", "timeupdate"]) audio.addEventListener(event, show);
</script>
