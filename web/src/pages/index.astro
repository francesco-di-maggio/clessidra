---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base>
<h1>Clessidra</h1>
<p class="lead">It's the instrument where you pour grains of sound from single drops into a dense cloud.</p>

<h2 class="label">About</h2>
<section class="panel">
  <div class="prose"><p>A granular instrument inspired by the hourglass. It explores the slow emptying of the glass and the fast trickle of single grains. It lets you capture and bend time through sound, slowing it down, speeding it up, reversing it or freezing it. Broken grains, like sand, are gathered and pieced back together, never quite the same and never fully still.</p></div>
</section>

<div class="status">
<dl class="panel meta">
  <dt>Status</dt><dd class="live">In progress</dd>
  <dt>Made at</dt><dd><a href="https://www.synthux.academy/residency">Synthux Design Residency 2026</a></dd>
  <dt>Hardware</dt><dd><a href="https://www.synthux.academy/">Synthux Simple Touch</a>, <a href="https://daisy.audio/">Electrosmith Daisy Seed</a></dd>
  <dt>Licence</dt><dd>MIT</dd>
</dl>
<canvas id="clock" class="clock" role="img" aria-label="The minute as sand: a grain each second"></canvas>
</div>

<div class="tiles">
  <a id="listen" class="panel" href={url("clessidra-target.m4a")}>
    <span class="text"><b>Listen</b><span class="sub" id="listen-time">0:30</span></span>
    <span class="arrow" aria-hidden="true">▶</span>
  </a>
  <a class="panel primary" href="play/">
    <span class="text"><b>Play</b><span class="sub">The same firmware in your browser. No board needed.</span></span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>
</Base>

<script>
  // The clock: the minute as sand, drawn as the Play page's glass. Each second
  // a grain falls, the bulb above holds what is left of the minute.
  import { Hourglass } from "../lib/hourglass";
  import { PARAM, PARAM_SIZE } from "../lib/engine";
  const glass = new Hourglass(document.getElementById("clock") as HTMLCanvasElement, true);
  const params = new Float32Array(PARAM_SIZE);
  params[PARAM.speed] = 1;
  params[PARAM.heading] = 1;
  function tick() {
    params[PARAM.sandLeft] = 1 - new Date().getSeconds() / 60;
    glass.update(params, true);
  }
  // On the second, as a clock ticks
  tick();
  setTimeout(() => (tick(), setInterval(tick, 1000)), 1000 - new Date().getMilliseconds());
</script>

<script>
  // The target sound, played in the page: a press starts it, another stops it
  const link = document.getElementById("listen") as HTMLAnchorElement;
  const time = document.getElementById("listen-time")!;
  const arrow = link.querySelector(".arrow")!;
  const audio = new Audio();
  audio.preload = "none";
  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  const total = time.textContent!;
  const show = () => {
    const playing = !audio.paused && !audio.ended;
    arrow.textContent = playing ? "■" : "▶";
    link.classList.toggle("on", playing);
    time.textContent = playing ? `${clock(audio.currentTime)} of ${total}` : total;
  };
  link.addEventListener("click", (e) => {
    e.preventDefault();
    if (!audio.src) audio.src = link.href;
    if (audio.paused) {
      audio.currentTime = 0;
      audio.play();
    } else audio.pause();
  });
  for (const event of ["play", "pause", "ended", "timeupdate"]) audio.addEventListener(event, show);
</script>
