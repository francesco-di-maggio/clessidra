---
import Base from "../layouts/Base.astro";
import TouchPanel from "../components/TouchPanel.astro";
import { CONTROLS } from "../lib/controls";

// What the help shows for each control, by id
const help = Object.fromEntries(CONTROLS.filter((c) => !c.free).map((c) => [c.id, { name: c.name, does: c.does ?? "", twin: c.twin ? `${c.twin.name}. ${c.twin.does}` : "" }]));
---
<Base title="Mapping" description="Clessidra's controls on the Synthux Simple Touch.">
<h1>Mapping</h1>
<p class="lead">What each control of the Simple Touch does.</p>
<div class="mapping">
  <div class="panel touch-panel"><TouchPanel /></div>
  <div class="stack">
    <div class="panel help" aria-live="polite">
      <span id="help-board" class="label">Control</span>
      <b id="help-name">Point at a control</b>
      <p id="help-does">Its function shows here. A second function, with Shift held, shows in orange.</p>
      <p id="help-twin" class="twin"></p>
    </div>
    <div class="panel note"><span class="label">Record</span>Tap or hold Rec. The sound becomes the loop.</div>
    <div class="panel note"><span class="label">Play</span>Speed, Position and Length move through it. Density and Size pour it as grains.</div>
    <div class="panel note"><span class="label">End</span>S07 decides what the loop does at its end: stop, turn over or go round.</div>
  </div>
</div>
<script type="application/json" id="help-data" set:html={JSON.stringify(help)} />
</Base>

<script>
  // The help for the control pointed at
  interface Help { name: string; does: string; twin: string }
  const help: Record<string, Help> = JSON.parse(document.getElementById("help-data")!.textContent!);
  const panel = document.querySelector<SVGSVGElement>(".touch")!;
  const out = { board: document.getElementById("help-board")!, name: document.getElementById("help-name")!, does: document.getElementById("help-does")!, twin: document.getElementById("help-twin")! };

  function describe(id: string) {
    for (const g of panel.querySelectorAll(".ctl")) g.classList.toggle("active", (g as SVGGElement).dataset.id === id);
    const h = help[id];
    out.board.textContent = id;
    out.name.textContent = h?.name ?? "Free";
    out.does.textContent = h?.does ?? "No function yet.";
    out.twin.textContent = h?.twin ? `Shift: ${h.twin}` : "";
  }

  for (const g of panel.querySelectorAll<SVGGElement>(".ctl")) {
    const id = g.dataset.id!;
    g.addEventListener("pointerenter", () => describe(id));
    g.addEventListener("focus", () => describe(id));
  }
</script>
